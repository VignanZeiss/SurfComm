<UserControl
    x:Class="SurfComm.Connect.View.ProgramMappingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SurfComm.Connect.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="10">

        <StackPanel
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Orientation="Horizontal">
            <Button
                Width="120"
                Height="20"
                Command="{Binding CreateNewProgramCommand}"
                Content="New Program" />
        </StackPanel>

        <DataGrid
            Margin="0,20,0,0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding Programs}"
            SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Id}"
                    Header="Program #" />

                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Info.Name}"
                    Header="Name" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Settings.CalculationStandard}"
                    Header="Standard" />

                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Settings.MeasurementType}"
                    Header="Type" />

                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding ParameterListDisplay}"
                    Header="Parameters" />

                <DataGridTemplateColumn Width="100" Header="Actions">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Width="60"
                                Command="{Binding DataContext.EditProgramCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Edit" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>
    </Grid>

</UserControl>
