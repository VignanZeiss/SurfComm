<UserControl
    x:Class="SurfComm.Connect.Views.SetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    Background="#F8F9FB"
    mc:Ignorable="d">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  Header  -->
            <RowDefinition Height="Auto" />
            <!--  Device section  -->
            <RowDefinition Height="10" />
            <!--  Spacer  -->
            <RowDefinition Height="*" />
            <!--  Settings list  -->
            <RowDefinition Height="Auto" />
            <!--  Buttons  -->
        </Grid.RowDefinitions>

        <!--  Header  -->
        <TextBlock
            Margin="0,0,0,15"
            HorizontalAlignment="Left"
            FontSize="22"
            FontWeight="SemiBold"
            Foreground="#2B3E50"
            Text="Device Setup" />

        <!--  Device Configuration Section  -->
        <Border
            Grid.Row="1"
            Padding="15"
            Background="White"
            BorderBrush="#D0D4D8"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{DynamicResource MaterialDesignElevation2}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Device Name  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,10,5"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Device Name:" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Width="200"
                    Margin="0,0,10,5"
                    ItemsSource="{Binding AvailableDevices}"
                    SelectedItem="{Binding DeviceConfig.DeviceName, Mode=TwoWay}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="80"
                    Command="{Binding TestDeviceCommand}"
                    Content="Test" />

                <!--  Connection status  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,2,0,8"
                    HorizontalAlignment="Left"
                    FontStyle="Italic"
                    Foreground="#007ACC"
                    Text="{Binding ConnectionString}" />

                <!--  Start Trigger  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="Start Trigger:" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="200"
                    ItemsSource="{Binding StartTriggerList}"
                    SelectedItem="{Binding DeviceConfig.StartTrigger, Mode=TwoWay}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Border>

        <!--  🟨 Category / Settings Section  -->
        <Border
            Grid.Row="3"
            Margin="0,10,0,0"
            Padding="15"
            Background="White"
            BorderBrush="#D0D4D8"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{DynamicResource MaterialDesignElevation1}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,10">
                                <!--  Category header  -->
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Foreground="#1C3D5A"
                                    Text="{Binding Name}" />

                                <!--  Settings  -->
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="220" />
                                                    <ColumnDefinition Width="200" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Name}" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    Width="160"
                                                    DisplayMemberPath="Name"
                                                    ItemsSource="{Binding Options}"
                                                    SelectedItem="{Binding SelectedOption, Mode=TwoWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator
                                    Height="1"
                                    Margin="0,5,0,5"
                                    Background="#EEE" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!--  🟧 Action Buttons  -->
        <StackPanel
            Grid.Row="4"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="100"
                Height="32"
                Background="#007ACC"
                Command="{Binding ApplyToDevice}"
                Content="Apply"
                FontWeight="SemiBold"
                Foreground="White" />
            <Button
                Width="100"
                Height="32"
                Background="#E1E5EA"
                Command="{Binding SaveCommand}"
                Content="Save"
                FontWeight="SemiBold"
                Foreground="#1C3D5A" />
        </StackPanel>
    </Grid>
</UserControl>
