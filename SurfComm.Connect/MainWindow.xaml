<Window
    x:Class="SurfComm.Connect.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:SurfComm.Connect.Views"
    xmlns:shell="clr-namespace:System.Windows;assembly=PresentationFramework"
    Title="SurfComm Connect"
    Width="900"
    Height="1000"
    WindowStyle="None"
    ResizeMode="CanResize"
    mc:Ignorable="d"
    Background="#FF2B2B30">

    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="5"
                  CaptionHeight="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#FF404040" BorderThickness="1">
        <Grid>

            <Grid.RowDefinitions>
                <!-- Title Bar>-->
                <RowDefinition Height="32"/>
                <!--Header-->
                <RowDefinition Height="60" />
                <!--  Menu bar -->
                <RowDefinition Height="60"/>
                <!-- Main content -->
                <RowDefinition Height="*"/>
                <!-- Status bar -->
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <!-- ===================== Ribbon 1: Title Bar ===================== -->
            <Border Grid.Row="0" Background="#FF1E1E1E"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon -->
                    <Image Grid.Column="0"
                             Source="/Assets/Icon.png"
                            Width="20"
                             Height="20"
                            Stretch="Uniform"
                                VerticalAlignment="Center"/>

                    <!-- App name + version -->
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="White"
                               FontSize="13"
                               Text="SurfComm Connect 1.0.0"/>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Width="32" Height="22" Padding="0"
                            Click="Minimize_Click">
                            <TextBlock Text="─" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>


                        <Button Width="32" Height="22" Padding="0"
                                Click="Maximize_Click">
                            <TextBlock Text="▢" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <Button Width="32" Height="22" Padding="0"  
                                Click="Close_Click">
                            <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>


                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== Ribbon 2: Brand Header ===================== -->
            <Border Grid.Row="1" Background="White">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ZEISS logo placeholder -->
                    <Border Background="White"
                            VerticalAlignment="Center" Height="50" Margin="10,0,0,0">
                        <Image Source="pack://application:,,,/Assets/CZ-Logo.png"
                                Stretch="Uniform"
                                 VerticalAlignment="Center">

                        </Image>

                    </Border>

                    <!-- Text -->
                    <TextBlock Grid.Column="1"
                               Text="ZEISS AUTOMATION"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="20,0,0,0"
                               FontSize="32"
                               Foreground="#333333"
                               FontWeight="SemiBold"/>

                    <!-- SurfCom image placeholder -->
                    <Border Grid.Column="2"
                            Width="90" Height="50"
                            Background=" White"
                            VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/HANDYSURF.png"
                            Stretch="Uniform"
                                VerticalAlignment="Center"
                              />
                    </Border>
                </Grid>
            </Border>

            <!-- ===================== Ribbon 3: Menu Bar ===================== -->
            <Border Grid.Row="2" Background="#FF2B2B30">
                <Menu Background="#FF2B2B30"
                      Foreground="White"
                      Height="30">
                    <MenuItem Header="_File" >
                        <MenuItem Header="Automatic Mode" Foreground="Black"/>
                        <MenuItem Header="Manual Mode" Foreground="Black"/>
                        <Separator/>
                        <MenuItem Header="Exit" Click="Close_Click" Foreground="Black"/>
                    </MenuItem>

                    <MenuItem Header="_Settings" >
                        <MenuItem Header="Device Setup" Command="{Binding ShowDeviceStepUpView}" Foreground="Black"/>
                        <MenuItem Header="Program Mapping" Foreground="Black"/>
                    </MenuItem>

                    <MenuItem Header="_Diagnostics" >
                        <MenuItem Header="I/O Monitor" Foreground="Black"/>
                    </MenuItem>

                    <MenuItem Header="_Commander" >
                        <MenuItem Header="Command Console" Foreground="Black"/>
                    </MenuItem>
                </Menu>
            </Border>

            <!-- ===================== Main Content Placeholder ===================== -->
            <ContentControl x:Name="MainContentHost"
                Grid.Row="3"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                   
                Content="{Binding CurrentView}" />

            <!-- ===================== Status Bar ===================== -->
            <Border Grid.Row="4" Background ="Black">
                <DockPanel Margin="8,0">
                    <TextBlock Text="System ready"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center">
                        <Border Margin="8,0" Padding="4,2" Background="#AAFFFFFF">
                            <TextBlock Text="OPC UA" FontSize="11"/>
                        </Border>
                        <Border Margin="0,0,8,0" Padding="4,2" Background="#AAFFFF99">
                            <TextBlock Text="SIM" FontSize="11"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentTime}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontSize="11"/>
                    </StackPanel>
                </DockPanel>
            </Border>


        </Grid>

    </Border>
</Window>
