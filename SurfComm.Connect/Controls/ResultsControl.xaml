<UserControl
    x:Class="SurfComm.Connect.Controls.ResultsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Margin="0,0,0,10"
        Padding="10"
        Background="White"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        CornerRadius="4">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!--  Title  -->
                <RowDefinition Height="*" />
                <!--  Results Table  -->
            </Grid.RowDefinitions>

            <!--  Header  -->
            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                FontSize="18"
                FontWeight="SemiBold"
                Text="Results Summary" />

            <!--  Table  -->
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                Background="White"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserResizeRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                ItemsSource="{Binding Results}"
                RowHeaderWidth="0">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Name}"
                        Header="Parameter" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Value}"
                        Header="Value" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Nominal}"
                        Header="Nominal" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding LowerTol}"
                        Header="Tolerance -" />

                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding UpperTol}"
                        Header="Tolerance +" />

                    <!--  COLOR CODED STATUS  -->
                    <DataGridTemplateColumn Width="*" Header="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="4"
                                    Background="{Binding StatusColor}"
                                    CornerRadius="3">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Text="{Binding StatusText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

        </Grid>
    </Border>

</UserControl>
