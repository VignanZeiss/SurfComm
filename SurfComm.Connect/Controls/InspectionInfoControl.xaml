<UserControl
    x:Class="SurfComm.Connect.Controls.InspectionInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Margin="0,0,0,10"
        Padding="12"
        Background="White"
        BorderBrush="#D0D0D0"
        BorderThickness="1"
        CornerRadius="4">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Inspection Number  -->
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="Inspection Number" />

            <ComboBox
                Grid.Column="1"
                Width="180"
                Height="26"
                DisplayMemberPath="Number"
                ItemsSource="{Binding InspectionPlans}"
                SelectedItem="{Binding SelectedPlan}" />

            <!--  Spacer  -->
            <Separator Grid.Column="2" Opacity="0" />

            <!--  Inspection Name  -->
            <TextBlock
                Grid.Column="3"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="Inspection Name" />

            <ComboBox
                Grid.Column="4"
                Width="240"
                Height="26"
                DisplayMemberPath="Name"
                ItemsSource="{Binding InspectionPlans}"
                SelectedItem="{Binding SelectedPlan}" />

        </Grid>

    </Border>
</UserControl>
